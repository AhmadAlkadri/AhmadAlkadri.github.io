---
config:
  theme: base
  themeVariables:
    background: '#fcfcfa'
    primaryColor: '#e8f1ef'
    primaryBorderColor: '#245f63'
    primaryTextColor: '#263437'
    lineColor: '#245f63'
    fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif'
    fontSize: '16px'
---
flowchart TB
    A["Specification"] --> B["Larger specification"]
    B --> C["Implementation"]
    C --> D["More implementation"]
    D --> E["Agent review"]
    E --> F["Agent revisions"]
    F --> G["Almost finished system"]
    G --> H["Human finally looks"]

    classDef node fill:#e8f1ef,stroke:#245f63,color:#263437;
    classDef terminal fill:#245f63,stroke:#174f55,color:#ffffff;
    class A,B,C,D,E,F,G node;
    class H terminal;
