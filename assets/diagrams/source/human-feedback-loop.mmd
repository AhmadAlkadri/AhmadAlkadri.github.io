---
config:
  theme: base
  themeVariables:
    background: '#fcfcfa'
    primaryColor: '#e8f1ef'
    primaryBorderColor: '#245f63'
    primaryTextColor: '#263437'
    lineColor: '#245f63'
    fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif'
    fontSize: '16px'
---
flowchart TB
    A["Intent"] --> B["Thin slice"]
    B --> C["Evidence"]
    C --> D["Human looks"]
    D --> E["Updated intent"]
    E --> F["Next thin slice"]

    classDef node fill:#e8f1ef,stroke:#245f63,color:#263437;
    classDef terminal fill:#245f63,stroke:#174f55,color:#ffffff;
    class A,B,C,D,E node;
    class F terminal;
