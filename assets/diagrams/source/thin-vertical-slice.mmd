---
config:
  theme: base
  themeVariables:
    background: '#fcfcfa'
    primaryColor: '#e8f1ef'
    primaryBorderColor: '#245f63'
    primaryTextColor: '#263437'
    lineColor: '#245f63'
    fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif'
    fontSize: '16px'
---
flowchart TB
    feature["One real capability"]

    subgraph api["API layer"]
      direction LR
      apiL["other"] --- apiS["slice"] --- apiR["other"]
    end

    subgraph logic["Logic layer"]
      direction LR
      logicL["other"] --- logicS["slice"] --- logicR["other"]
    end

    subgraph models["Models layer"]
      direction LR
      modelsL["other"] --- modelsS["slice"] --- modelsR["other"]
    end

    subgraph infra["Infrastructure layer"]
      direction LR
      infraL["other"] --- infraS["slice"] --- infraR["other"]
    end

    subgraph tests["Tests layer"]
      direction LR
      testsL["other"] --- testsS["slice"] --- testsR["other"]
    end

    verified["Verified end-to-end"]

    feature --> apiS
    apiS --> logicS --> modelsS --> infraS --> testsS
    testsS --> verified

    classDef context fill:#f5f7f5,stroke:#b6c7c3,color:#526366;
    classDef slice fill:#245f63,stroke:#174f55,color:#ffffff,font-weight:bold;
    classDef callout fill:#f1f4f0,stroke:#245f63,color:#263437;
    class apiL,apiR,logicL,logicR,modelsL,modelsR,infraL,infraR,testsL,testsR context;
    class apiS,logicS,modelsS,infraS,testsS slice;
    class feature,verified callout;
