---
config:
  theme: base
  themeVariables:
    background: '#fcfcfa'
    primaryColor: '#e8f1ef'
    primaryBorderColor: '#245f63'
    primaryTextColor: '#263437'
    lineColor: '#245f63'
    fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif'
    fontSize: '16px'
---
flowchart LR
  A["Goal"] --> B["Design thin slices"]
  B --> C["Find ready slice"]
  C --> D["Fresh-context worker"]
  D --> E["Verify / review"]
  E -->|accepted| F["Durable checkpoint"]
  E -->|blocked / negative| G["Preserve result"]
  F --> H{"More ready slices?"}
  G --> H
  H -->|yes| C
  H -->|no| I["Campaign complete"]

  classDef node fill:#e8f1ef,stroke:#245f63,color:#263437;
  classDef terminal fill:#245f63,stroke:#174f55,color:#ffffff;
  classDef decision fill:#f1f4f0,stroke:#245f63,color:#263437;
  class A,B,C,D,E,F,G node;
  class H decision;
  class I terminal;
